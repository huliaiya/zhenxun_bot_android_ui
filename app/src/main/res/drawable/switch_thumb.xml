<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <size
                android:width="24dp"
                android:height="24dp" />
            <solid android:color="@color/glass_surface_strong_top" />
            <corners android:radius="24dp" />
            <stroke
                android:width="1.5dp"
                android:color="?android:colorPrimaryDark" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <size
                android:width="24dp"
                android:height="24dp" />
            <solid android:color="@color/glass_surface_strong_top" />
            <corners android:radius="24dp" />
            <stroke
                android:width="1.5dp"
                android:color="@color/switch_unchecked" />
        </shape>
    </item>
</selector>
