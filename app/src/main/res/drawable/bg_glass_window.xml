<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="@color/glass_backdrop_bottom"
                android:startColor="@color/glass_backdrop_top" />
        </shape>
    </item>

    <item
        android:width="460dp"
        android:height="460dp"
        android:gravity="top|left">
        <shape android:shape="rectangle">
            <gradient
                android:endColor="@android:color/transparent"
                android:centerX="0"
                android:centerY="0"
                android:gradientRadius="230dp"
                android:startColor="@color/glass_blob_pink"
                android:type="radial" />
        </shape>
    </item>

    <item
        android:width="420dp"
        android:height="420dp"
        android:gravity="top|right">
        <shape android:shape="rectangle">
            <gradient
                android:endColor="@android:color/transparent"
                android:centerX="1"
                android:centerY="0"
                android:gradientRadius="210dp"
                android:startColor="@color/glass_blob_teal"
                android:type="radial" />
        </shape>
    </item>

    <item
        android:width="520dp"
        android:height="520dp"
        android:gravity="bottom|right">
        <shape android:shape="rectangle">
            <gradient
                android:endColor="@android:color/transparent"
                android:centerX="1"
                android:centerY="1"
                android:gradientRadius="260dp"
                android:startColor="@color/glass_blob_violet"
                android:type="radial" />
        </shape>
    </item>

    <item
        android:width="360dp"
        android:height="360dp"
        android:gravity="bottom|left">
        <shape android:shape="rectangle">
            <gradient
                android:endColor="@android:color/transparent"
                android:centerX="0"
                android:centerY="1"
                android:gradientRadius="180dp"
                android:startColor="@color/glass_blob_blue"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
